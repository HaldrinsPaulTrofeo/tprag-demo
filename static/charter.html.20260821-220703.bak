<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Citizen's Charter Q&A — Pagsanjan MAO</title>
<style>
  :root{
    --navy:#0038A8; --navy-d:#002b80; --red:#CE1126; --gold:#FCD116; --amber:#b8791b;
    --ink:#1a1a1a; --muted:#5a6168; --line:#d7dce3; --bg:#f0f2f5; --card:#fff;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{min-height:100%;}
  body{font-family:"Segoe UI",Roboto,-apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif;
       background:var(--bg);color:var(--ink);line-height:1.55;display:flex;flex-direction:column;min-height:100vh;-webkit-font-smoothing:antialiased;}
  .gov-strip{background:#fff;border-bottom:1px solid var(--line);font-size:12px;color:var(--muted);}
  .gov-strip .in{max-width:1100px;margin:0 auto;padding:5px 18px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  .gov-strip .flag{display:inline-flex;width:18px;height:12px;border:1px solid #ccc;overflow:hidden;border-radius:2px;flex:none;}
  .banner{background:var(--navy);color:#fff;}
  .banner .in{max-width:1100px;margin:0 auto;padding:14px 18px;display:flex;align-items:center;gap:14px;justify-content:space-between;flex-wrap:wrap;}
  .brandblock{display:flex;align-items:center;gap:14px;}
  .seal{width:60px;height:60px;border-radius:50%;background:#fff;flex:none;object-fit:contain;padding:3px;border:2px solid var(--gold);box-shadow:0 1px 2px rgba(0,0,0,.15);} .seals{display:inline-flex;gap:8px;align-items:center;}
  
  .banner h1{font-size:16px;font-weight:700;line-height:1.25;}
  .banner .sub{font-size:12.5px;color:#cdd9f3;margin-top:1px;}
  nav.navlinks{display:flex;gap:4px;}
  nav.navlinks a{color:#dbe4f7;text-decoration:none;font-size:13px;font-weight:600;padding:7px 13px;border-radius:5px;}
  nav.navlinks a.active{background:rgba(255,255,255,.16);color:#fff;}
  nav.navlinks a:hover{background:rgba(255,255,255,.10);}
  .tricolor{height:5px;display:flex;} .tricolor i{flex:1;}
  .tricolor .b{background:#1a6dd6;}.tricolor .r{background:var(--red);}.tricolor .y{background:var(--gold);}

  main{flex:1;display:flex;justify-content:center;padding:0 18px;}
  .chatwrap{width:100%;max-width:760px;display:flex;flex-direction:column;padding:28px 0 40px;}
  .intro{margin-bottom:18px;}
  .intro .eyebrow{display:inline-block;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
                  color:var(--navy);background:#e7eefb;padding:5px 12px;border-radius:20px;margin-bottom:12px;}
  .intro h2{font-size:24px;font-weight:700;margin-bottom:6px;}
  .intro p{color:var(--muted);font-size:14.5px;}
  .examples{display:flex;flex-direction:column;gap:8px;margin-top:18px;}
  .chip{text-align:left;font:inherit;font-size:14px;cursor:pointer;background:#fff;color:var(--ink);
        border:1px solid var(--line);border-radius:8px;padding:12px 15px;transition:border-color .15s,background .15s;}
  .chip:hover{border-color:var(--navy);background:#f6f9ff;}
  .chip::before{content:"›";color:var(--navy);font-weight:700;margin-right:9px;}

  .messages{display:flex;flex-direction:column;gap:14px;margin:4px 0;}
  .msg{display:flex;}
  .msg.user{justify-content:flex-end;}
  .msg .bubble{max-width:88%;padding:13px 16px;border-radius:12px;font-size:14.5px;}
  .msg.user .bubble{background:var(--navy);color:#fff;border-bottom-right-radius:4px;}
  .msg.bot .bubble{background:#fff;border:1px solid var(--line);border-bottom-left-radius:4px;box-shadow:0 1px 2px rgba(16,24,40,.04);}
  .answer{white-space:pre-wrap;}
  .sources{margin-top:11px;padding-top:11px;border-top:1px dashed var(--line);}
  .sources .lbl{font-size:11.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:6px;font-weight:600;}
  .cite{display:inline-block;font-size:12px;background:#e7eefb;color:var(--navy);font-weight:600;padding:3px 9px;border-radius:20px;margin:0 6px 6px 0;}
  /* General-info fallback (not a charter citation) */
  .gi-bubble{border-color:var(--amber)!important;background:#fffdf6!important;}
  .geninfo{margin-top:11px;padding-top:11px;border-top:1px dashed var(--amber);font-size:12px;color:#7a5a16;line-height:1.5;}
  .gi-tag{display:inline-block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;
          background:#fbf0db;color:var(--amber);padding:2px 9px;border-radius:20px;margin-right:6px;}
  .thinking{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:14px;}
  .dots{display:inline-flex;gap:3px;}
  .dots span{width:6px;height:6px;border-radius:50%;background:var(--navy);opacity:.4;animation:bl 1.2s infinite;}
  .dots span:nth-child(2){animation-delay:.2s;} .dots span:nth-child(3){animation-delay:.4s;}
  @keyframes bl{0%,80%,100%{opacity:.25;}40%{opacity:1;}}
  .slownote{font-size:12px;color:var(--muted);margin-top:7px;}

  .composer{display:flex;gap:10px;margin-top:18px;position:sticky;bottom:0;padding:14px 0;background:linear-gradient(transparent,var(--bg) 22%);}
  .composer input{flex:1;font:inherit;font-size:15px;padding:13px 15px;border:1px solid var(--line);border-radius:8px;background:#fff;}
  .composer input:focus{outline:none;border-color:var(--navy);box-shadow:0 0 0 3px rgba(0,56,168,.15);}
  .btn{font:inherit;font-size:14.5px;font-weight:600;cursor:pointer;border:none;background:var(--navy);color:#fff;padding:13px 24px;border-radius:8px;transition:background .15s;}
  .btn:hover{background:var(--navy-d);} .btn:disabled{opacity:.6;cursor:default;}
  .disclaim{font-size:12px;color:var(--muted);text-align:center;margin-top:4px;}
  @media(max-width:560px){ nav.navlinks{width:100%;} .intro h2{font-size:21px;} }

  footer{background:#1f2937;color:#cbd5e1;font-size:13px;}
  footer .in{max-width:1180px;margin:0 auto;padding:30px 28px 20px;display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  footer .ftitle{color:#fff;font-weight:700;font-size:13.5px;margin-bottom:10px;}
  footer .fline{color:#aab4c0;font-size:12.5px;line-height:1.9;}
  footer .fcol a{display:block;color:#cbd5e1;text-decoration:none;font-size:12.5px;line-height:1.95;}
  footer .fcol a:hover{color:#fff;text-decoration:underline;}
  footer .fbar{max-width:1180px;margin:0 auto;padding:14px 28px;border-top:1px solid #374151;display:flex;flex-wrap:wrap;gap:6px 18px;justify-content:space-between;color:#94a3b8;font-size:11.5px;}
  footer .fbar-r{color:#cbd5e1;font-weight:600;}
  @media(max-width:680px){ footer .in{grid-template-columns:1fr;gap:18px;} }


  nav.navlinks a.login-link{background:var(--gold);color:#1a1a1a;font-weight:700;margin-left:6px;}
  nav.navlinks a.login-link:hover{background:#e6bd0f;}
</style>

<link rel="stylesheet" href="/static/gov.css">
<script src="/static/site.js" defer></script>
</head>
<body data-page="charter">
  <div class="gov-strip"><div class="in">
    <span class="flag"><i style="background:#0038A8;height:6px;display:block"></i><i style="background:#CE1126;height:6px;display:block"></i></span>
    <span>Republic of the Philippines</span><span style="color:#b6bcc4">·</span>
    <span>All content is in the public domain unless otherwise stated</span>
  </div></div>
  <div class="banner"><div class="in">
    <div class="brandblock">
      <span class="seals"><img class="seal" src="data:image/png;base64," alt="Pagsanjan Municipal Agriculture Office (FITS Center) seal"><img class="seal" src="data:image/png;base64," alt="Municipality of Pagsanjan seal"></span>
      <div><h1>Municipal Agriculture Office</h1><div class="sub">Citizen's Charter Q&amp;A · Pagsanjan, Laguna</div></div>
    </div>
    <nav class="navlinks"><a href="/charter" class="active">Citizen's Charter</a><a href="/citizen">Pet Vaccination Check</a><a href="/checker">Form Checker</a><a href="/" class="login-link">Staff Dashboard</a></nav>
  </div></div>
  <div class="tricolor"><i class="b"></i><i class="r"></i><i class="y"></i></div>

  <main>
    <div class="chatwrap">
      <div class="intro">
        <span class="eyebrow">Citizen's Charter</span>
        <h2>Ask about fees and procedures</h2>
        <p>Answers come only from the official Pagsanjan Citizen's Charter, with the page where each answer was found.</p>
        <div class="examples" id="examples">
          <button class="chip">What is the fee for a Rabies (DFAT) test at the RADDL?</button>
          <button class="chip">How much is a soil analysis at the Regional Soils Laboratory?</button>
          <button class="chip">What is the first step to submit a soil sample?</button>
        </div>
      </div>
      <div class="messages" id="messages"></div>
      <div class="composer">
        <input type="text" id="q" placeholder="Type your question about the charter…" autocomplete="off">
        <button class="btn" id="ask">Ask</button>
      </div>
      <div class="disclaim">Answers are generated from the charter document and may need verification for official use.</div>
    </div>
  </main>

  <footer>
  <div class="in">
    <div class="fcol">
      <div class="ftitle">Municipal Agriculture Office</div>
      <div class="fline">FITS Center — Pagsanjan, Laguna</div>
      <div class="fline">pagsanjanagricultureoffice@gmail.com</div>
      <div class="fline">(0928) 912 3302 · (049) 539-3171</div>
    </div>
    <div class="fcol">
      <div class="ftitle">About this site</div>
      <a href="#accessibility">Accessibility Statement</a>
      <a href="#transparency">Transparency Seal</a>
      <a href="#privacy">Privacy Policy</a>
      <a href="#foi">Freedom of Information</a>
    </div>
    <div class="fcol">
      <div class="ftitle">Government Links</div>
      <a href="https://www.da.gov.ph" target="_blank" rel="noopener">Department of Agriculture</a>
      <a href="https://ati.da.gov.ph" target="_blank" rel="noopener">Agricultural Training Institute</a>
      <a href="https://www.gov.ph" target="_blank" rel="noopener">GOV.PH Portal</a>
    </div>
  </div>
  <div class="fbar">
    <span>© <span class="yr"></span> Municipal Agriculture Office of Pagsanjan. All content is in the public domain unless otherwise stated.</span>
    <span class="fbar-r">Republic of the Philippines</span>
  </div>
</footer>

<script>
document.querySelectorAll(".yr").forEach(e=>e.textContent=new Date().getFullYear());
const $ = (s) => document.querySelector(s);
const messages = $("#messages");

function addUser(text) {
  const d = document.createElement("div");
  d.className = "msg user";
  d.innerHTML = `<div class="bubble">${escapeHtml(text)}</div>`;
  messages.appendChild(d); scrollDown();
}
function addThinking() {
  const d = document.createElement("div");
  d.className = "msg bot"; d.id = "thinking";
  d.innerHTML = `<div class="bubble">
    <div class="thinking"><span>Searching the charter</span><span class="dots"><span></span><span></span><span></span></span></div>
    <div class="slownote">The local model is reading the document — this can take a minute or two.</div>
  </div>`;
  messages.appendChild(d); scrollDown();
}
function removeThinking(){ const t = $("#thinking"); if (t) t.remove(); }

function addAnswer(data) {
  const d = document.createElement("div");
  d.className = "msg bot";
  let src = "";
  if (data.general_info) {
    // Fallback general guidance — clearly marked, NOT an official charter citation.
    src = `<div class="geninfo"><span class="gi-tag">General information</span>
           Not found in the Citizen's Charter. This is general guidance — please confirm current details with the office.</div>`;
  } else if (data.sources && data.sources.length) {
    const cites = data.sources.map(s => `<span class="cite">Page ${s.page}</span>`).join("");
    src = `<div class="sources"><div class="lbl">Source in charter</div>${cites}</div>`;
  }
  d.innerHTML = `<div class="bubble${data.general_info ? " gi-bubble" : ""}"><div class="answer">${escapeHtml(data.answer || "No answer returned.")}</div>${src}</div>`;
  messages.appendChild(d); scrollDown();
}
function addError(msg) {
  const d = document.createElement("div");
  d.className = "msg bot";
  d.innerHTML = `<div class="bubble"><div class="answer">${escapeHtml(msg)}</div></div>`;
  messages.appendChild(d); scrollDown();
}

function scrollDown(){ messages.scrollTop = messages.scrollHeight; window.scrollTo(0, document.body.scrollHeight); }
function escapeHtml(s){ return (s||"").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }

let busy = false;
async function ask(text) {
  const question = (text ?? $("#q").value).trim();
  if (!question || busy) return;
  busy = true; $("#ask").disabled = true; $("#q").value = "";
  $("#examples").style.display = "none";
  addUser(question); addThinking();
  try {
    const r = await fetch("/api/charter", {
      method: "POST", headers: {"Content-Type":"application/json"},
      body: JSON.stringify({question})
    });
    removeThinking();
    if (r.ok) { addAnswer(await r.json()); }
    else { const e = await r.json().catch(()=>({})); addError(e.detail || "Something went wrong answering that."); }
  } catch(e) {
    removeThinking(); addError("Could not reach the server. Is it still running?");
  }
  busy = false; $("#ask").disabled = false; $("#q").focus();
}

$("#ask").addEventListener("click", () => ask());
$("#q").addEventListener("keydown", (e) => { if (e.key === "Enter") ask(); });
document.querySelectorAll(".chip").forEach(c => c.addEventListener("click", () => ask(c.textContent)));
$("#q").focus();
</script>
</body>
</html>
